DATABASE_URL=postgres://saip:saip@localhost:5433/saip

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth credentials.
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sent to Google as the `hd` hint and enforced against the id token's hd claim, so a
# personal Gmail account cannot complete the flow. Clear it only if Princeton asserts
# a Workspace domain different from the email domain.
GOOGLE_HOSTED_DOMAIN=princeton.edu

ALLOWED_EMAIL_DOMAIN=princeton.edu

# The address the seed invites as President. Set this before the first seed.
SEED_PRESIDENT_EMAIL=

# Dev-only sign-in shortcut. Never set this in production.
DEV_LOGIN=0

# Throwaway password for the seeded development account. Dev only.
DEV_PRESIDENT_PASSWORD=

# Where uploaded files are written. Outside public/ on purpose.
UPLOAD_DIR=

# Web push. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@princeton.edu
